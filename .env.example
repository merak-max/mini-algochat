# Server-only values. Never expose real keys in frontend code.
OPENAI_API_KEY=
# Leave blank for OpenAI. Custom providers must support the Responses API.
OPENAI_BASE_URL=
# Opt in only for a trusted gateway that accepts requests without credentials.
# Requires OPENAI_BASE_URL; suppresses Authorization even if a key is present.
OPENAI_ALLOW_KEYLESS=false
OPENAI_MODEL=gpt-5.2
PORT=8787
HOST=127.0.0.1
# Needed only when frontend and backend are hosted at different origins.
FRONTEND_ORIGIN=

# Frontend value. This is safe because it points to your backend URL, not to OpenAI.
# Leave blank locally: Vite proxies /api to the backend on port 8787.
VITE_API_BASE_URL=
